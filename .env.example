# Local only. Never commit real secrets.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3120
PORT=3120
FAMILY_DB_PATH=.data/family.sqlite
# AI defaults off. Enable only within a recorded, remaining authorization.
FAMILY_UPLOAD_PATH=.data/uploads
# Existing synthetic approval only: shared existing ledger, no new budget file.
# Explicitly allow only synthetic QA actor IDs; never enable real-user inputs under this approval.
INTEGRATION_LIVE_APPROVED=false
INTEGRATION_BUDGET_PATH=
INTEGRATION_SYNTHETIC_ACTOR_IDS=
# Optional absolute key-file path loaded by scripts/start-local.mjs; never copy secrets.
OPENAI_KEY_ENV_FILE=

# Optional product storage profile: STORAGE_ENV_FILE=.env.supabase.local npm run local
# The selected profile overrides .env.local. Keep AI disabled during storage validation.
STORAGE_ENV_FILE=
DATABASE_URL=
# PEM text inside double quotes (actual multiline value); official Supabase CA required.
DATABASE_SSL_CA=
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=family-memories

# Change only for a separate, explicitly selected recovery profile.
DATABASE_SCHEMA=woorijip

# Operational demo policy: 20 calls per actor/KST day, $5 reserved daily across service.
# Configuration only; live calls and real-user text transfer require explicit activation approval.
AI_MODE=operational
AI_LIVE_APPROVED=false

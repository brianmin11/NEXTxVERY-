{
  "name": "nextxvery",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:engine && next build --webpack",
    "start": "next start",
    "lint": "eslint app components lib src tests scripts next.config.ts playwright.config.ts",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "npm run build:engine && tsc --noEmit",
    "build:engine": "npm run build --workspace @family-os/relationship-ai",
    "test:host": "node --import tsx --test tests/host*.test.ts",
    "test:e2e": "playwright test",
    "local": "node scripts/start-local.mjs"
  },
  "dependencies": {
    "@family-os/relationship-ai": "^0.1.0",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "workspaces": [
    "packages/relationship-ai"
  ],
  "engines": {
    "node": ">=24.15"
  }
}
